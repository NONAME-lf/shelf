{
  "name": "@shelf/web",
  "version": "1.0.0",
  "private": true,
  "description": "Shelf — веб-клієнт для віддаленої папки з файлами",
  "author": "Artemii Mekshakov",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "smoke": "next build && node scripts/smoke.mjs",
    "screenshots": "next build && node scripts/screenshots.mjs"
  },
  "dependencies": {
    "@shelf/shared": "workspace:*",
    "@shelf/ui": "workspace:*",
    "lucide-react": "^1.48.0",
    "next": "16.3.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.4",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "fake-indexeddb": "^6.2.5",
    "playwright": "^1.63.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "vitest": "^3.2.7"
  }
}
