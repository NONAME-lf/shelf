{
  "name": "shelf",
  "private": true,
  "packageManager": "pnpm@10.34.6",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "typecheck": "pnpm -r run typecheck",
    "stack:infra": "docker compose --env-file docker/.env -f docker/compose.yml up -d --wait postgres minio",
    "stack:down": "docker compose --env-file docker/.env -f docker/compose.yml down",
    "stack:reset": "docker compose --env-file docker/.env -f docker/compose.yml down -v"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["@prisma/client", "@prisma/engines", "prisma", "electron", "esbuild"]
  }
}
